{
  "plugin": {
    "name": "tlm-plugin-example-ca",
    "version": "1.0",
    "executions": [
      {
        "os": "windows",
        "type": "exe",
        "exe": "java",
        "args": [
          "-jar",
          "tlm-plugin-example-ca-1.0.jar"
        ],
        "env": ["JAVA_HOME=${TG_JAVA_HOME}","Path=${JAVA_HOME}\\bin;${Path}","MAX_CHUNK=15","PROCESS_TIMEOUT=30m"]
      },
      {
        "os": "linux",
        "type": "exe",
        "exe": "java",
        "args": [
          "-jar",
          "tlm-plugin-example-ca-1.0.jar"
        ],
        "env": ["JAVA_HOME=${TG_JAVA_HOME}","PATH=${JAVA_HOME}/bin:${PATH}","MAX_CHUNK=15","PROCESS_TIMEOUT=30m"]
      }
    ]
  }
}
